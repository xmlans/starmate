    <string name="proactive_battery_title">Battery &amp; autostart</string>
    <string name="proactive_battery_intro">Some phones stop background apps to save battery, which can delay or block her messages. Allow the settings below for your phone.</string>
    <string name="proactive_battery_opt_section">Battery optimization</string>
    <string name="proactive_battery_opt_title">Ignore battery optimization</string>
    <string name="proactive_battery_opt_granted">Allowed</string>
    <string name="proactive_battery_opt_needed">Tap to allow, so the system doesn\'t hold back her check-ins</string>
    <string name="proactive_battery_your_phone">%1$s (your phone)</string>
    <string name="proactive_battery_open">Open settings</string>
    <string name="proactive_battery_other_section">Other</string>
    <string name="proactive_battery_app_details">App details</string>
    <string name="proactive_battery_app_details_summary">Battery, background and notification settings for Starmate</string>
    <string name="proactive_battery_keepalive_hint_title">Still missing messages?</string>
    <string name="proactive_battery_keepalive_hint">Turn on Keep alive on the previous page, and lock Starmate in the recent apps list if your phone supports it.</string>
    <string name="proactive_battery_lock_hint">Lock Starmate in the recent apps list if your phone supports it, and check the phone-specific steps above.</string>

    <string name="proactive_vendor_xiaomi">Xiaomi / Redmi / POCO</string>
    <string name="proactive_vendor_xiaomi_steps">1. Settings → Apps → Manage apps → Starmate → turn on Autostart.\n2. In the same page open Battery saver and choose No restrictions.\n3. In recent apps, pull Starmate down to lock it.</string>
    <string name="proactive_vendor_huawei">Huawei / Honor</string>
    <string name="proactive_vendor_huawei_steps">1. Settings → Battery → App launch → find Starmate and turn off Manage automatically.\n2. In the dialog, allow Auto-launch, Secondary launch and Run in background.\n3. In recent apps, pull Starmate down to lock it.</string>
    <string name="proactive_vendor_oppo">OPPO / realme / OnePlus</string>
    <string name="proactive_vendor_oppo_steps">1. Settings → Apps → Auto launch (or App management → Starmate) → allow Auto launch.\n2. Starmate → Battery usage → allow background activity.\n3. In recent apps, tap the menu on Starmate and choose Lock.</string>
    <string name="proactive_vendor_vivo">vivo / iQOO</string>
    <string name="proactive_vendor_vivo_steps">1. i Manager → App manager → Autostart manager → allow Starmate.\n2. Settings → Battery → Background power consumption → allow Starmate.\n3. In recent apps, pull Starmate down to lock it.</string>
    <string name="proactive_vendor_samsung">Samsung</string>
    <string name="proactive_vendor_samsung_steps">1. Settings → Battery → Background usage limits → make sure Starmate is not under Sleeping or Deep sleeping apps.\n2. Add Starmate to Never sleeping apps.\n3. Settings → Apps → Starmate → Battery → choose Unrestricted.</string>
</resources>
