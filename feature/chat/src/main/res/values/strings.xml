    <string name="chat_welcome_title">Hi, nice to meet you</string>
    <string name="chat_welcome_body">Starmate is a companion who lives on your phone. She remembers what you share, writes a little diary, and checks in on you now and then.</string>
    <string name="chat_welcome_point_key">You bring your own model API key. It\'s stored encrypted on this phone only.</string>
