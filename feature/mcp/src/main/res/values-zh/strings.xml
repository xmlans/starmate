<resources>
    <string name="mcp_settings_title">联网服务</string>
    <string name="mcp_settings_intro">用你自己的 key 接入联网搜索和地图。每个服务默认关闭，它们的工具只在聊天时提供，返回的内容只当作资料。key 加密保存在这台手机上，只发给对应的服务。</string>
    <string name="mcp_tavily_title">Tavily 联网搜索</string>
    <string name="mcp_tavily_desc">让她能搜索网页、读取网页内容。key 在 tavily.com 申请。</string>
    <string name="mcp_amap_title">高德地图</string>
    <string name="mcp_amap_desc">让她能查地点、路线和天气（中国大陆）。key 在 lbs.amap.com 申请。</string>
