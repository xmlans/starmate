<resources>
    <string name="mcp_settings_title">Online services</string>
    <string name="mcp_settings_intro">Connect web search and maps with your own key. Each service is off by default. Its tools are only offered in chat, and what they return is treated as data. The key is stored encrypted on this phone and is only sent to that service.</string>
    <string name="mcp_tavily_title">Tavily web search</string>
    <string name="mcp_tavily_desc">Lets her search the web and read pages. Get a key at tavily.com.</string>
    <string name="mcp_amap_title">AMap</string>
    <string name="mcp_amap_desc">Lets her look up places, routes and weather in mainland China. Get a key at lbs.amap.com.</string>
