<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Play 特供版：去掉 Play 不允许的权限和服务。
  - REQUEST_IGNORE_BATTERY_OPTIMIZATIONS：Play 只允许少数类别的应用申请，陪伴类不在其中。
    电池引导页改为打开系统的电池优化列表，那个页面不需要这个权限。
  - 保活前台服务（specialUse 类型）：要提交使用理由并接受审核，保活很难通过。
    主动消息平时靠定时唤醒，不依赖它；保活开关在这个版本里不显示（AppEdition.keepAlive = false）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="remove" />

    <application>
        <service
            android:name="org.xmyun.starmate.feature.proactive.keepalive.KeepAliveService"
            tools:node="remove" />
    </application>
</manifest>
